<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RezTopPhotoSystem</AssemblyName>
    <RootNamespace>RezTopPhotoSystem</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.369" />
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
    <Reference Include="K4-WorldText-SharedAPI">
      <HintPath>lib/K4-WorldText-SharedAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="WASDSharedAPI">
      <HintPath>lib/WASDSharedAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
