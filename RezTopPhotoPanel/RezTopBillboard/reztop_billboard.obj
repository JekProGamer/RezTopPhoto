# RezTopPhoto billboard model source
# Display face 300 x 100 units; aspect ratio 3:1; front faces toward -Y
mtllib reztop_billboard.mtl
o RezTopPhoto_Billboard
# outer front corners
v -154 -5 -54
v 154 -5 -54
v 154 -5 54
v -154 -5 54
# inner photo surface corners
v -150 -5.2 -50
v 150 -5.2 -50
v 150 -5.2 50
v -150 -5.2 50
# rear corners
v -154 5 -54
v 154 5 -54
v 154 5 54
v -154 5 54
# UVs for full 3:1 image
vt 0 0
vt 1 0
vt 1 1
vt 0 1
usemtl Frame_Black
f 1 2 6 5
f 2 3 7 6
f 3 4 8 7
f 4 1 5 8
f 1 9 10 2
f 2 10 11 3
f 3 11 12 4
f 4 12 9 1
f 9 12 11 10
usemtl Photo_Surface
f 5/1 6/2 7/3 8/4
